# PostgreSQL — dos roles, a proposito
#
# El de la aplicacion NO puede ser superusuario: Postgres deja que los
# superusuarios se salten Row Level Security, y con eso el aislamiento entre
# clubes desaparece. cn_app lo crea migrations/0.6-row-level-security.sql, y la
# contrasena se pone a mano con \password cn_app.
PGDATABASE=cn_servicies
PGUSER=cn_app
PGPASSWORD=change_me

# Rol de migraciones: crea el esquema, siembra datos y es el superusuario del
# contenedor de Postgres. La aplicacion nunca se conecta con este.
MIGRATION_USER=postgres
MIGRATION_PASSWORD=change_me

# JWT
# Generalo con: openssl rand -base64 32
# Se decodifica como Base64 y debe dar al menos 32 bytes (HS256).
JWT_SECRET=generate_me_with_openssl_rand_base64_32

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Limite de intentos de login: ver application.properties, todo tiene valor por
# defecto y aqui solo hace falta lo que se quiera cambiar.
#
# ESTO SI HAY QUE PONERLO EN PRODUCCION, descomentado, en cuanto la API este
# detras del tunel de Cloudflare: sin ello todas las peticiones llegan con la IP
# del proxy, comparten el limite por IP y los fallos de un desconocido dejan al
# club entero sin poder entrar. No lo actives en local ni con la API expuesta
# directamente: ahi X-Forwarded-For la pone quien quiere.
# FORWARD_HEADERS_STRATEGY=framework

# Cloudflare Tunnel token (obtained from the Cloudflare Zero Trust dashboard)
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Bootstrap admin user — leave empty to skip creation on startup
ADMIN_USERNAME=adminjaes
ADMIN_PASSWORD=change_me